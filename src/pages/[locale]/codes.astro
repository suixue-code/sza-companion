---
import BaseLayout from '@layouts/BaseLayout.astro';
import CodesActiveTable from '@components/codes/CodesActiveTable.astro';
import CodesHonestyNotice from '@components/codes/CodesHonestyNotice.astro';
import CodeAlertSubscribe from '@components/codes/CodeAlertSubscribe.astro';
import CodesOtherTable from '@components/codes/CodesOtherTable.astro';
import ToolsGuidesStrip from '@components/ToolsGuidesStrip.astro';
import codes from '../../data/codes.json';
import siteMeta from '../../data/site-meta.json';
import { localizedStaticPaths, resolveLocalizedParam } from '@i18n/localized/static-paths';
import { localePath, lastReviewedDisplay } from '@i18n/localized/paths';
import { getCodesCopy } from '@i18n/localized/codes';
import { articleSchema, breadcrumbSchema, faqSchema, itemListSchema } from '@lib/seo';

export function getStaticPaths() {
	return localizedStaticPaths();
}

const locale = resolveLocalizedParam(Astro.params.locale);
if (!locale) return Astro.redirect('/');

const copy = getCodesCopy(locale);
const reviewed = lastReviewedDisplay(locale, siteMeta);
const pageUrl = new URL(localePath(locale, '/codes/'), Astro.site).toString();
const homeUrl = new URL(localePath(locale, '/'), Astro.site).toString();

const activeCodes = codes.filter((code) => code.status === 'active');
const disputedCodes = codes.filter((code) => code.status === 'disputed');
const otherCodes = codes.filter((code) => code.status !== 'active' && code.status !== 'disputed');

const tableLabels = {
	...copy.tableLabels,
	sourceLabels: {
		howWeKnow:
			locale === 'es' ? 'Cómo lo sabemos' : locale === 'pt-br' ? 'Como sabemos' : '依据说明',
		statusBasis:
			locale === 'es' ? 'Base del estado' : locale === 'pt-br' ? 'Base do status' : '状态依据',
		conflict: locale === 'es' ? 'Conflicto' : locale === 'pt-br' ? 'Conflito' : '冲突',
		legacySources:
			locale === 'es' ? 'Otras referencias' : locale === 'pt-br' ? 'Outras referências' : '其他参考',
		inGame:
			locale === 'es'
				? 'Prueba in-game en este sitio'
				: locale === 'pt-br'
					? 'Teste in-game neste site'
					: '本站游戏内测试',
		sourcesToggle:
			locale === 'es' ? 'Detalles de fuentes' : locale === 'pt-br' ? 'Detalhes das fontes' : '来源详情',
	},
};

const copiedLabel =
	locale === 'es' ? 'Copiado' : locale === 'pt-br' ? 'Copiado' : '已复制';

const expiredTitle =
	locale === 'es'
		? 'Caducados o no verificados'
		: locale === 'pt-br'
			? 'Expirados ou não verificados'
			: '已失效或未核实';
const expiredDesc =
	locale === 'es'
		? 'Visibles cuando los rastreadores no coinciden tras actualizaciones de Roblox.'
		: locale === 'pt-br'
			? 'Mantidos visíveis quando rastreadores discordam após updates do Roblox.'
			: 'Roblox 更新后追踪站不一致时仍保留显示。';

const breadcrumbHome =
	locale === 'es' ? 'Inicio' : locale === 'pt-br' ? 'Início' : '首页';

const schema = [
	articleSchema({
		title: copy.title,
		description: copy.description,
		url: pageUrl,
		dateModified: siteMeta.lastPublicReview,
	}),
	itemListSchema(
		locale === 'es'
			? 'Códigos activos de Survive Zombie Arena'
			: locale === 'pt-br'
				? 'Códigos ativos de Survive Zombie Arena'
				: 'Survive Zombie Arena 有效兑换码',
		activeCodes.map((code) => ({
			name: code.code,
			url: `${pageUrl}#${code.code.toLowerCase()}`,
		})),
	),
	faqSchema(copy.faq),
	breadcrumbSchema([
		{ name: breadcrumbHome, url: homeUrl },
		{ name: copy.h1, url: pageUrl },
	]),
];
---

<BaseLayout title={copy.title} description={copy.description} locale={locale} schema={schema}>
	<section class="page-hero compact">
		<div class="shell two-col mobile-hero-stack">
			<div>
				<p class="eyebrow">
					<span class="pulse"></span>
					{copy.eyebrow} {reviewed}
				</p>
				<h1>{copy.h1}</h1>
				<p class="geo-snap">{copy.geoSnap}</p>
				<p class="lead">{copy.lead}</p>
			</div>
			<aside class="quick-answer">
				<strong>{copy.fastAnswerTitle}</strong>
				<p>{copy.fastAnswerBody}</p>
			</aside>
		</div>
	</section>

	<section class="content-section">
		<div class="shell">
			<CodesHonestyNotice locale={locale} />
			<div class="section-title" style="margin-top: 24px;">
				<h2>{copy.activeTitle}</h2>
				<p>{copy.activeDesc}</p>
			</div>
			<CodesActiveTable codes={activeCodes} labels={tableLabels} />
			<p class="notice" style="margin-top: 1rem;">{copy.feedbackNotice}</p>
		</div>
	</section>

	{
		disputedCodes.length > 0 && (
			<section class="content-section">
				<div class="shell">
					<div class="section-title">
						<h2>{copy.disputedTitle}</h2>
						<p>{copy.disputedDesc}</p>
					</div>
					<CodesOtherTable
						codes={disputedCodes}
						labels={{ ...tableLabels, source: copy.tableLabels.source }}
						statusLabel={{ disputed: copy.statusDisputed }}
					/>
				</div>
			</section>
		)
	}

	{
		otherCodes.length > 0 && (
			<section class="content-section">
				<div class="shell">
					<div class="section-title">
						<h2>{expiredTitle}</h2>
						<p>{expiredDesc}</p>
					</div>
					<CodesOtherTable codes={otherCodes} labels={{ ...tableLabels, source: copy.tableLabels.source }} />
				</div>
			</section>
		)
	}

	<section class="content-section">
		<div class="shell article-grid">
			<article class="article-flow">
				<section>
					<h2>{copy.redeemTitle}</h2>
					<ol class="check-list">
						{copy.redeemSteps.map((step) => <li>{step}</li>)}
					</ol>
				</section>
				<section>
					<h2>{copy.sourcesTitle}</h2>
					<ul class="check-list">
						<li>{copy.sourcesItems[0]}</li>
						<li>
							<a href={siteMeta.robloxExperienceUrl} rel="noopener noreferrer" target="_blank">
								{copy.sourcesItems[1]}
							</a>
						</li>
						<li>
							<a href={siteMeta.robloxGroupUrl} rel="noopener noreferrer" target="_blank">
								{copy.sourcesItems[2]}
							</a>
						</li>
					</ul>
				</section>
				<section>
					<h2>FAQ</h2>
					<div class="faq-list">
						{copy.faq.map((item) => (
							<details>
								<summary>{item.question}</summary>
								<p>{item.answer}</p>
							</details>
						))}
					</div>
				</section>
			</article>
			<aside class="side-rail">
				<CodeAlertSubscribe locale={locale} />
				<div class="rail-panel accent-panel">
					<strong>{locale === 'zh-cn' ? '兑换之后' : locale === 'pt-br' ? 'Depois de resgatar' : 'Después de canjear'}</strong>
					<p>
						{locale === 'zh-cn'
							? '用信用点规划器决定 Medic 还是 Marksman（1 万 / 1.5 万）。'
							: locale === 'pt-br'
								? 'Use o Credit Planner para Medic (10k) ou Marksman (15k).'
								: 'Planifica Medic (10k) o Marksman (15k) con el Credit Planner.'}
					</p>
					<a href={localePath(locale, '/tools/credit-planner/')}>
						{locale === 'zh-cn' ? '信用点规划器' : 'Credit Planner'}
					</a>
					<a href={localePath(locale, '/beginner-guide/')}>
						{locale === 'zh-cn' ? '新手指南' : locale === 'pt-br' ? 'Guia para iniciantes' : 'Guía principiante'}
					</a>
				</div>
			</aside>
		</div>
	</section>

	<ToolsGuidesStrip locale={locale} />

	<script is:inline define:vars={{ copyLabel: copy.tableLabels.copy, copiedLabel }}>
		async function copyText(value) {
			if (navigator.clipboard?.writeText) {
				try {
					await navigator.clipboard.writeText(value);
					return;
				} catch (_error) {}
			}
			const textarea = document.createElement('textarea');
			textarea.value = value;
			textarea.setAttribute('readonly', '');
			textarea.style.position = 'fixed';
			textarea.style.opacity = '0';
			document.body.appendChild(textarea);
			textarea.select();
			document.execCommand('copy');
			textarea.remove();
		}

		document.querySelectorAll('[data-copy]').forEach((button) => {
			button.addEventListener('click', async () => {
				const value = button.getAttribute('data-copy') || '';
				await copyText(value);
				button.textContent = copiedLabel;
				button.classList.add('copied');
				window.setTimeout(() => {
					button.textContent = copyLabel;
					button.classList.remove('copied');
				}, 1400);
			});
		});
	</script>
</BaseLayout>
