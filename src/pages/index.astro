---
import BaseLayout from '@layouts/BaseLayout.astro';
import codes from '../data/codes.json';
import siteMeta from '../data/site-meta.json';
import siteStats from '../data/site-stats.json';
import classes from '../data/classes.json';
import { collectionSchema, faqSchema, SITE_NAME } from '@lib/seo';

const activeCount = codes.filter((code) => code.status === 'active').length;
const fmt = new Intl.NumberFormat('en-US');

const tierSummary = {
	S: classes.filter((c) => c.tierSolo === 'S'),
	A: classes.filter((c) => c.tierSolo === 'A'),
	B: classes.filter((c) => c.tierSolo === 'B'),
	C: classes.filter((c) => c.tierSolo === 'C'),
};

const playerRoutes = [
	{
		href: '/codes/',
		kicker: 'Redeem',
		title: 'Codes',
		desc: 'Working codes, dispute notes, and confidence labels before your next run.',
		stat: `${activeCount} active now`,
	},
	{
		href: '/weapons/',
		kicker: 'Loadout',
		title: 'Best Weapons',
		desc: 'Walk the best weapon path from handgun to shotgun, rifle, and new F2P guns.',
		stat: 'Upgrade path',
	},
	{
		href: '/classes/',
		kicker: 'Build',
		title: 'Best Classes',
		desc: 'Compare class costs, roles, and which picks pay off for solo or team play.',
		stat: `${classes.length} tracked`,
	},
	{
		href: '/tools/credit-planner/',
		kicker: 'Plan',
		title: 'Credits',
		desc: 'Map your next unlock from the Credits you already have.',
		stat: 'Browser-only',
	},
];

const battlefieldLinks = [
	{
		href: '/waves/',
		title: 'Wave Guide',
		desc: 'Survive Zombie Arena waves: Auto Skip rules, Credit phases, enemy density, and Nightmare status.',
	},
	{
		href: '/enemies/',
		title: 'Enemies',
		desc: 'Survive Zombie Arena enemies: elite priority, VOLATILE preview, density phases, and class counters.',
	},
	{
		href: '/maps/',
		title: 'Rooftop Map',
		desc: 'Survive Zombie Arena map guide: Rooftop chokepoints, Atlantis preview, FPS notes, and Square Arena context.',
	},
	{
		href: '/updates/',
		title: 'Updates',
		desc: 'May 2026 patch trail: World Ender, Nightmare Mode, Necromancer buff, and Galactic previews.',
	},
	{
		href: '/best-loadouts/',
		title: 'Best Loadouts',
		desc: 'Best Survive Zombie Arena loadouts for solo, team support, Credits farming, high waves, and leaderboard pushes.',
	},
	{
		href: '/leaderboard/',
		title: 'Leaderboard',
		desc: 'High-wave team comp, pacing, Auto Skip risk, and known public data gaps.',
	},
];

const faq = [
	{
		question: 'What is SZA Companion?',
		answer: `${SITE_NAME} is an unofficial fan site for Roblox Survive Zombie Arena by Nectarforge Studios. We track codes with confidence labels, class costs, weapon progression, and browser-only planning tools—not hidden drop rates or official endorsement.`,
	},
	{
		question: 'Is SZA Companion official?',
		answer: 'No. We are not affiliated with Roblox Corporation or Nectarforge Studios. Official links live on our Discord page.',
	},
	{
		question: 'What is the best first class unlock?',
		answer: 'Medic (10,000 Credits) for co-op support or Marksman (15,000 Credits) for solo DPS. See the beginner guide and Credit Planner before buying Ninja or Demolitionist.',
	},
	{
		question: 'How often are codes updated?',
		answer: `Public sources were last reviewed ${siteMeta.lastPublicReviewDisplay}. Only Zombies is high-confidence active; GALACTIC is disputed. Always confirm in-game before each session.`,
	},
	{
		question: 'Does the Credit Planner read my account?',
		answer: 'No. Calculators run entirely in your browser. Enter Credits manually and tick owned classes.',
	},
	{
		question: 'Where do I play Survive Zombie Arena?',
		answer: `Launch the official Roblox experience: ${siteMeta.robloxExperienceLabel} (${siteMeta.robloxExperienceUrl}). Redeem codes via Shop → Redeem Codes.`,
	},
];

const schema = [
	collectionSchema(
		`${SITE_NAME} — codes, classes & tools`,
		'Unofficial Survive Zombie Arena hub for codes, class tiers, weapon progression, and credit planning.',
		new URL('/', Astro.site).toString(),
	),
	faqSchema(faq),
];
---

<BaseLayout
	title="Survive Zombie Arena Codes, Classes & Tools"
	description="Unofficial Survive Zombie Arena companion: active codes, class tier list, beginner guide, weapon progression, and Credit Planner. Last reviewed from public sources."
	schema={schema}
>
	<section class="arena-hero">
		<div class="arena-hero-media" aria-hidden="true"></div>
		<div class="shell arena-hero-grid">
			<div class="arena-hero-copy">
				<p class="eyebrow"><span class="pulse"></span>Unofficial guide · updated {siteMeta.lastPublicReviewDisplay}</p>
				<h1>Survive Zombie Arena <em>briefing room</em></h1>
				<p class="arena-lead">
					Codes, weapon routes, class reads, and Credit planning for Roblox <strong>Survive Zombie Arena</strong>. Prep the Rooftop run before the wave timer catches up.
				</p>
				<div class="hero-actions">
					<a class="btn primary" href="/codes/">Check codes</a>
					<a class="btn secondary" href="/tools/credit-planner/">Open planner</a>
					<a class="btn dark" href="/beginner-guide/">First five runs</a>
				</div>
				<div class="trust-row">
					<span class="trust">{activeCount} active code{activeCount === 1 ? '' : 's'}</span>
					<span class="trust">{classes.length} classes tracked</span>
					<span class="trust">Estimate-only tools</span>
				</div>
			</div>
			<aside class="arena-board" aria-label="Survive Zombie Arena live snapshot">
				<div class="arena-board-head">
					<p>Live run board</p>
					<strong>Rooftop prep</strong>
				</div>
				<div class="arena-stat-grid">
					<div><span>Visits</span><strong>{fmt.format(siteStats.visits)}</strong></div>
					<div><span>Favorites</span><strong>{fmt.format(siteStats.favorites)}</strong></div>
					<div><span>Server</span><strong>{siteStats.maxPlayers} players</strong></div>
					<div><span>Session</span><strong>~{siteStats.avgSessionMinutes} min</strong></div>
				</div>
				<div class="arena-phase-list">
					<a href="/codes/"><span>Phase 01</span><strong>Redeem before you queue</strong></a>
					<a href="/weapons/"><span>Phase 02</span><strong>Choose the weapon spend</strong></a>
					<a href="/tier-list/"><span>Phase 03</span><strong>Lock the class role</strong></a>
				</div>
				<p class="muted">Roblox API + public audit · checked {siteStats.lastChecked}</p>
			</aside>
		</div>
	</section>

	<section class="content-section route-section">
		<div class="shell">
			<div class="section-title">
				<p class="eyebrow">Pick a lane</p>
				<h2>Start with the move your next run needs.</h2>
			</div>
			<ul class="route-grid">
				{playerRoutes.map((route) => (
					<li class="route-card">
						<a href={route.href}>
							<span>{route.kicker}</span>
							<strong>{route.title}</strong>
							<p>{route.desc}</p>
							<em>{route.stat}</em>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="content-section prep-section">
		<div class="shell">
			<article class="prep-copy">
				<p class="eyebrow">Wave prep</p>
				<h2>Spend before panic spending wins the round.</h2>
				<p>
					Plan the first upgrades, check the Rooftop read, then move into deeper guides when a class or event changes your route.
				</p>
				<ol class="check-list prep-list">
					<li>Redeem <strong>Zombies</strong> for 2,500 Credits before the session starts.</li>
					<li>Weapon path: handgun to shotgun to rifle before giant unlock swings.</li>
					<li>First class: <strong>Medic</strong> for co-op or <strong>Marksman</strong> for solo pressure.</li>
				</ol>
				<div class="hero-actions">
					<a class="btn primary" href="/tools/credit-planner/">Plan Credits</a>
					<a class="btn secondary" href="/guides/">Read guides</a>
				</div>
				<a
					class="play-strip"
					href={siteMeta.robloxExperienceUrl}
					rel="noopener noreferrer"
					target="_blank"
				>
					<img src="/images/sza-game/roblox-game-icon.png" alt="" width="56" height="56" />
					<span class="play-strip-copy">
						<span class="play-strip-label">Official Roblox experience</span>
						<strong>{siteMeta.robloxExperienceLabel}</strong>
					</span>
					<span class="play-strip-cta" aria-hidden="true">Open in Roblox</span>
				</a>
			</article>
		</div>
	</section>

	<section class="content-section signal-section">
		<div class="shell signal-grid">
			<article class="signal-panel code-signal">
				<p class="eyebrow">Code confidence</p>
				<h2>Promote the code you can defend.</h2>
				<div class="signal-code">
					<strong>Zombies</strong>
					<span>2,500 Credits</span>
				</div>
				<p>Official Discord post plus public cross-check. Re-confirm in-game each session.</p>
				<a class="btn secondary" href="/codes/">Open code report</a>
			</article>
			<article class="signal-panel dispute-signal">
				<p class="eyebrow">Dispute log</p>
				<h2>GALACTIC stays flagged.</h2>
				<p>Some media pages list it active. Discord #codes does not, and the public success signal is weak.</p>
				<a class="btn dark" href="/codes/#galactic">See dispute notes</a>
			</article>
		</div>
	</section>

	<section class="content-section">
		<div class="shell">
			<div class="section-title">
				<p class="eyebrow">Class scan</p>
				<h2>Read the solo tier board at a glance.</h2>
				<p>Then jump into the full tier list for team roles, farming context, and unlock advice.</p>
			</div>
			<div class="tier-board">
				<div class="data-card tier-card"><h3>S tier</h3><p>{tierSummary.S.map((c) => c.name).join(', ') || '—'}</p></div>
				<div class="data-card tier-card"><h3>A tier</h3><p>{tierSummary.A.map((c) => c.name).join(', ')}</p></div>
				<div class="data-card tier-card"><h3>B tier</h3><p>{tierSummary.B.map((c) => c.name).join(', ')}</p></div>
				<div class="data-card tier-card"><h3>C tier</h3><p>{tierSummary.C.map((c) => c.name).join(', ')}</p></div>
			</div>
		</div>
	</section>


	<section class="content-section battlefield-section">
		<div class="shell">
			<div class="section-title">
				<p class="eyebrow">Battlefield index</p>
				<h2>Find the deeper topics without digging through long wiki pages.</h2>
				<p>Each route gives a fast answer first, then the source notes and tactical details players actually need.</p>
			</div>
			<ul class="shortcut-grid">
				{battlefieldLinks.map((item) => (
					<li class="shortcut">
						<a href={item.href}>
							<strong>{item.title}</strong>
							<p>{item.desc}</p>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="content-section">
		<div class="shell article-flow">
			<section>
				<h2>What is Survive Zombie Arena?</h2>
				<p>
					A 25-player co-op zombie arena on Roblox by {siteMeta.developerName}. Earn Credits each wave to buy in-run weapons and permanent class unlocks. The Rooftop Map (April 2026) replaced Square Arena with stairwell chokepoints that favor Tactician barricades and Necromancer funnel plays.
				</p>
				<p>
					Also available in <a href="/es/">Español</a>, <a href="/pt-br/">Português (BR)</a>, and <a href="/zh-cn/">简体中文</a> (core pages).
				</p>
				<p>
					Play on Roblox: <a href={siteMeta.robloxExperienceUrl} rel="noopener noreferrer" target="_blank">{siteMeta.robloxExperienceLabel}</a>.
				</p>
			</section>
			<section>
				<h2>FAQ</h2>
				<div class="faq-list">
					{faq.map((item) => (
						<details>
							<summary>{item.question}</summary>
							<p>{item.answer}</p>
						</details>
					))}
				</div>
			</section>
			<p class="notice" style="margin-top: 24px;">
				{siteMeta.lastPublicReviewNoteEn}
			</p>
			<p class="muted">
				<a href="/about/">About this site</a> · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/discord/">Official links</a>
			</p>
		</div>
	</section>
</BaseLayout>
