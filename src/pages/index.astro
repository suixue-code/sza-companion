---
import SiteImage from '@components/SiteImage.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import codes from '../data/codes.json';
import siteMeta from '../data/site-meta.json';
import siteStats from '../data/site-stats.json';
import classes from '../data/classes.json';
import { collectionSchema, faqSchema, SITE_NAME } from '@lib/seo';

const activeCount = codes.filter((code) => code.status === 'active').length;
const fmt = new Intl.NumberFormat('en-US');
const compactFmt = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });

const tierSummary = {
	S: classes.filter((c) => c.tierSolo === 'S'),
	A: classes.filter((c) => c.tierSolo === 'A'),
	B: classes.filter((c) => c.tierSolo === 'B'),
	C: classes.filter((c) => c.tierSolo === 'C'),
};

const playerRoutes = [
	{
		href: '/codes/',
		kicker: 'Redeem',
		title: 'Codes',
		desc: 'Working codes, dispute notes, and confidence labels before your next run.',
		stat: `${activeCount} active now`,
	},
	{
		href: '/weapons/',
		kicker: 'Loadout',
		title: 'Best Weapons',
		desc: 'Walk the best weapon path from handgun to shotgun, rifle, and new F2P guns.',
		stat: 'Upgrade path',
	},
	{
		href: '/classes/',
		kicker: 'Build',
		title: 'Best Classes',
		desc: 'Compare class costs, roles, and which picks pay off for solo or team play.',
		stat: `${classes.length} tracked`,
	},
	{
		href: '/tools/credit-planner/',
		kicker: 'Plan',
		title: 'Credits',
		desc: 'Map your next unlock from the Credits you already have.',
		stat: 'Browser-only',
	},
];

const battlefieldLinks = [
	{
		href: '/waves/',
		title: 'Wave Guide',
		desc: 'Survive Zombie Arena waves: Auto Skip rules, Credit phases, enemy density, and Nightmare status.',
	},
	{
		href: '/enemies/',
		title: 'Enemies',
		desc: 'Survive Zombie Arena enemies: elite priority, VOLATILE preview, density phases, and class counters.',
	},
	{
		href: '/maps/',
		title: 'Rooftop Map',
		desc: 'Survive Zombie Arena map guide: Rooftop chokepoints, Atlantis media reports, FPS notes, and Square Arena context.',
	},
	{
		href: '/updates/',
		title: 'Updates',
		desc: 'May 2026 patch trail: Roblox API refresh, World Ender, Nightmare Mode, Necromancer buff, and Galactic reports.',
	},
	{
		href: '/best-loadouts/',
		title: 'Best Loadouts',
		desc: 'Best Survive Zombie Arena loadouts for solo, team support, Credits farming, high waves, and leaderboard pushes.',
	},
	{
		href: '/leaderboard/',
		title: 'Leaderboard',
		desc: 'High-wave team comp, pacing, Auto Skip risk, and known public data gaps.',
	},
];

const wikiHubSections = [
	{
		title: 'Codes and Credits',
		body: 'Start every account with the code check. Zombies is the only high-confidence working code we publish right now, and it gives 2,500 Credits. That is a head start, not a full class unlock, so the next decision is whether to stabilize weapon spending or save toward Medic and Marksman.',
		items: ['Copy Zombies before queueing', 'Check GALACTIC as disputed', 'Plan your next permanent unlock'],
		links: [
			['Codes', '/codes/'],
			['GALACTIC status', '/codes/galactic/'],
			['Credit Planner', '/tools/credit-planner/'],
			['How to redeem codes', '/guides/how-to-redeem-codes/'],
		],
	},
	{
		title: 'Classes and Tier List',
		body: 'Class choice changes how you survive Rooftop lanes. Medic is the safest co-op first buy, Marksman is the cleaner solo and farm pick, Tactician anchors stairwells, and Necromancer is the long-term high-wave goal. Bastion is powerful for teams but competes with the 250,000 Credit Necromancer grind.',
		items: ['Medic or Marksman first', 'Tactician for chokepoints', 'Necromancer for late-wave scaling'],
		links: [
			['Tier List', '/tier-list/'],
			['All Classes', '/classes/'],
			['Best class solo', '/guides/best-class-solo/'],
		],
	},
	{
		title: 'Weapons and Loadouts',
		body: 'Most early wipes come from skipping the basic weapon path. Handgun into shotgun and then rifle is still the reliable route before chasing named or event weapons. Use the loadout tool when you already know your class and want a compact plan for solo, team support, farming, or leaderboard attempts.',
		items: ['Handgun to shotgun to rifle', 'Named guns after core upgrades', 'Loadout plan by scenario'],
		links: [
			['Weapons', '/weapons/'],
			['Loadout Builder', '/tools/loadout-builder/'],
			['Best Weapons Guide', '/guides/best-weapons/'],
		],
	},
	{
		title: 'Maps, Waves, and Enemies',
		body: 'The current public meta is built around Rooftop Map chokepoints. Stairs reward barricades, piercing lines, and controlled retreats; open-field wandering gets punished once enemy density rises. Pair the map notes with wave spending rules before turning on Auto Skip.',
		items: ['Rooftop stairwell lanes', 'Auto Skip after setup', 'Elite priority before panic spend'],
		links: [
			['Maps', '/maps/'],
			['Waves', '/waves/'],
			['Enemies', '/enemies/'],
		],
	},
	{
		title: 'Galactic Event and Updates',
		body: 'Public event guides now report Galactic content, Void Shards, Galactic Crates, and Atlantis. The Roblox page/API confirmed a May 26 game update but did not name Galactic or Atlantis, so we separate media-reported details from official-page facts instead of blending them into one claim.',
		items: ['Void Shards and crates', 'Atlantis status notes', 'May 2026 patch trail'],
		links: [
			['Galactic Event', '/events/galactic/'],
			['Void Shards', '/guides/void-shards/'],
			['Updates', '/updates/'],
		],
	},
	{
		title: 'Verification and Official Links',
		body: 'This site is unofficial, so every claim needs a route back to sources. Use our source ledger for code disputes and data gaps, then jump to the official Roblox page, Discord, or Nectarforge Studios group when you want the first-party channel.',
		items: ['Source ledger for disputes', 'Official Roblox experience', 'Discord and group links'],
		links: [
			['Sources', '/sources/'],
			['Official links', '/discord/'],
			['About', '/about/'],
		],
	},
];

const officialLinks = [
	['Play on Roblox', siteMeta.robloxExperienceUrl],
	['Official Discord', siteMeta.discordInviteUrl],
	['Nectarforge Studios group', siteMeta.robloxGroupUrl],
	['Roblox place ID reference', `${siteMeta.robloxExperienceUrl}?placeId=${siteMeta.placeId}`],
];

const faq = [
	{
		question: 'What is SZA Companion?',
		answer: `${SITE_NAME} is an unofficial fan site for Roblox Survive Zombie Arena by Nectarforge Studios. We track codes with confidence labels, class costs, weapon progression, and browser-only planning tools—not hidden drop rates or official endorsement.`,
	},
	{
		question: 'Is SZA Companion official?',
		answer: 'No. We are not affiliated with Roblox Corporation or Nectarforge Studios. Official links live on our Discord page.',
	},
	{
		question: 'What is the best first class unlock?',
		answer: 'Medic (10,000 Credits) for co-op support or Marksman (15,000 Credits) for solo DPS. See the beginner guide and Credit Planner before buying Ninja or Demolitionist.',
	},
	{
		question: 'How often are codes updated?',
		answer: `Public sources were last reviewed ${siteMeta.lastPublicReviewDisplay}. Only Zombies is high-confidence active; GALACTIC is disputed. Always confirm in-game before each session.`,
	},
	{
		question: 'Does the Credit Planner read my account?',
		answer: 'No. Calculators run entirely in your browser. Enter Credits manually and tick owned classes.',
	},
	{
		question: 'Where do I play Survive Zombie Arena?',
		answer: `Launch the official Roblox experience: ${siteMeta.robloxExperienceLabel} (${siteMeta.robloxExperienceUrl}). Redeem codes via Shop → Redeem Codes.`,
	},
];

const schema = [
	collectionSchema(
		`${SITE_NAME} — codes, classes & tools`,
		'Unofficial Survive Zombie Arena hub for codes, class tiers, weapon progression, and credit planning.',
		new URL('/', Astro.site).toString(),
	),
	faqSchema(faq),
];
---

<BaseLayout
	title="Survive Zombie Arena Codes & Class Planner"
	description="Find current Survive Zombie Arena codes, copy Zombies for 2,500 Credits, compare best classes, plan Credits, and follow the weapon upgrade path."
	schema={schema}
>
	<link
		slot="head"
		rel="preload"
		as="image"
		href="/images/sza-game/roblox-thumbnail-3.webp"
		type="image/webp"
		fetchpriority="high"
	/>
	<section class="arena-hero">
		<div class="arena-hero-media" aria-hidden="true"></div>
		<div class="shell arena-hero-grid">
			<div class="arena-hero-copy">
				<p class="eyebrow"><span class="pulse"></span>Unofficial guide · updated {siteMeta.lastPublicReviewDisplay}</p>
				<h1>Survive Zombie Arena <em>codes & planner</em></h1>
				<p class="arena-lead">
					Copy working codes, pick the next class, and plan Credits for Roblox <strong>Survive Zombie Arena</strong>. Start with Zombies, then prep the Rooftop run before the wave timer catches up.
				</p>
				<div class="hero-actions">
					<a class="btn primary" href="/codes/">Copy codes</a>
					<a class="btn secondary" href="/tools/credit-planner/">Open planner</a>
					<a class="btn dark" href="/beginner-guide/">First five runs</a>
				</div>
				<div class="trust-row">
					<span class="trust">{activeCount} active code{activeCount === 1 ? '' : 's'}</span>
					<span class="trust">{compactFmt.format(siteStats.visits)} visits</span>
					<span class="trust">{classes.length} classes tracked</span>
					<span class="trust">Estimate-only tools</span>
				</div>
			</div>
			<aside class="arena-board" aria-label="Survive Zombie Arena live snapshot">
				<div class="arena-board-head">
					<p>Live run board</p>
					<strong>Rooftop prep</strong>
				</div>
				<div class="arena-stat-grid">
					<div><span>Visits</span><strong>{fmt.format(siteStats.visits)}</strong></div>
					<div><span>Favorites</span><strong>{fmt.format(siteStats.favorites)}</strong></div>
					<div><span>Playing</span><strong>{fmt.format(siteStats.livePlayersAtCheck)}</strong></div>
					<div><span>Server</span><strong>{siteStats.maxPlayers} players</strong></div>
				</div>
				<div class="arena-phase-list">
					<a href="/codes/"><span>Phase 01</span><strong>Redeem before you queue</strong></a>
					<a href="/weapons/"><span>Phase 02</span><strong>Choose the weapon spend</strong></a>
					<a href="/tier-list/"><span>Phase 03</span><strong>Lock the class role</strong></a>
				</div>
				<p class="muted">Roblox API · updated {siteStats.gameLastUpdated.slice(0, 10)} · checked {siteStats.lastChecked}</p>
			</aside>
		</div>
	</section>

	<section class="content-section route-section">
		<div class="shell">
			<div class="section-title">
				<p class="eyebrow">Pick a lane</p>
				<h2>Start with the move your next run needs.</h2>
			</div>
			<ul class="route-grid">
				{playerRoutes.map((route) => (
					<li class="route-card">
						<a href={route.href}>
							<span>{route.kicker}</span>
							<strong>{route.title}</strong>
							<p>{route.desc}</p>
							<em>{route.stat}</em>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="content-section prep-section">
		<div class="shell">
			<article class="prep-copy">
				<p class="eyebrow">Wave prep</p>
				<h2>Spend before panic spending wins the round.</h2>
				<p>
					Plan the first upgrades, check the Rooftop read, then move into deeper guides when a class or event changes your route.
				</p>
				<ol class="check-list prep-list">
					<li>Redeem <strong>Zombies</strong> for 2,500 Credits before the session starts.</li>
					<li>Weapon path: handgun to shotgun to rifle before giant unlock swings.</li>
					<li>First class: <strong>Medic</strong> for co-op or <strong>Marksman</strong> for solo pressure.</li>
				</ol>
				<div class="hero-actions">
					<a class="btn primary" href="/tools/credit-planner/">Plan Credits</a>
					<a class="btn secondary" href="/guides/">Read guides</a>
				</div>
				<a
					class="play-strip"
					href={siteMeta.robloxExperienceUrl}
					rel="noopener noreferrer"
					target="_blank"
				>
					<SiteImage
						base="/images/sza-game/roblox-game-icon-128"
						width={56}
						height={56}
						loading="lazy"
						decoding="async"
					/>
					<span class="play-strip-copy">
						<span class="play-strip-label">Official Roblox experience</span>
						<strong>{siteMeta.robloxExperienceLabel}</strong>
					</span>
					<span class="play-strip-cta" aria-hidden="true">Open in Roblox</span>
				</a>
			</article>
		</div>
	</section>

	<section class="content-section signal-section">
		<div class="shell signal-grid">
			<article class="signal-panel code-signal">
				<p class="eyebrow">Code confidence</p>
				<h2>Promote the code you can defend.</h2>
				<div class="signal-code">
					<strong>Zombies</strong>
					<span>2,500 Credits</span>
				</div>
				<p>Official Discord post plus public cross-check. Re-confirm in-game each session.</p>
				<a class="btn secondary" href="/codes/">Open code report</a>
			</article>
			<article class="signal-panel dispute-signal">
				<p class="eyebrow">Dispute log</p>
				<h2>GALACTIC stays flagged.</h2>
				<p>Some guides report Void Shards, others report Credits. The Roblox page does not name the code, so we keep it disputed.</p>
				<a class="btn dark" href="/codes/galactic/">See dispute notes</a>
			</article>
		</div>
	</section>

	<section class="content-section">
		<div class="shell">
			<div class="section-title">
				<p class="eyebrow">Class scan</p>
				<h2>Read the solo tier board at a glance.</h2>
				<p>Then jump into the full tier list for team roles, farming context, and unlock advice.</p>
			</div>
			<div class="tier-board">
				<div class="data-card tier-card"><h3>S tier</h3><p>{tierSummary.S.map((c) => c.name).join(', ') || '—'}</p></div>
				<div class="data-card tier-card"><h3>A tier</h3><p>{tierSummary.A.map((c) => c.name).join(', ')}</p></div>
				<div class="data-card tier-card"><h3>B tier</h3><p>{tierSummary.B.map((c) => c.name).join(', ')}</p></div>
				<div class="data-card tier-card"><h3>C tier</h3><p>{tierSummary.C.map((c) => c.name).join(', ')}</p></div>
			</div>
		</div>
	</section>

	<section class="content-section">
		<div class="shell article-flow">
			<div class="section-title">
				<p class="eyebrow">Wiki route map</p>
				<h2>Use this hub when you need more than a code list.</h2>
				<p>
					Codes are only useful when they connect to the next decision: what to spend, which class to unlock, where to hold, and which claims still need checking.
				</p>
			</div>
			<div class="data-grid">
				{wikiHubSections.map((section) => (
					<article class="data-card">
						<h3>{section.title}</h3>
						<p>{section.body}</p>
						<ul class="check-list">
							{section.items.map((item) => <li>{item}</li>)}
						</ul>
						<p>
							{section.links.map((link, index) => (
								<>
									{index > 0 && ' · '}
									<a href={link[1]}>{link[0]}</a>
								</>
							))}
						</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="content-section battlefield-section">
		<div class="shell">
			<div class="section-title">
				<p class="eyebrow">Battlefield index</p>
				<h2>Find the deeper topics without digging through long wiki pages.</h2>
				<p>Each route gives a fast answer first, then the source notes and tactical details players actually need.</p>
			</div>
			<ul class="shortcut-grid">
				{battlefieldLinks.map((item) => (
					<li class="shortcut">
						<a href={item.href}>
							<strong>{item.title}</strong>
							<p>{item.desc}</p>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="content-section">
		<div class="shell article-flow">
			<section>
				<h2>What is Survive Zombie Arena?</h2>
				<p>
					A 25-player co-op zombie arena on Roblox by {siteMeta.developerName}. Earn Credits each wave to buy in-run weapons and permanent class unlocks. The Rooftop Map (April 2026) replaced Square Arena with stairwell chokepoints that favor Tactician barricades and Necromancer funnel plays.
				</p>
				<p>
					The practical loop is simple: redeem codes before a run, buy the weapon path that keeps you alive, then save for the class that matches your playstyle. Most players should not jump straight to Legendary picks. Medic and Marksman create cleaner early progress, while Tactician and Necromancer become stronger once you understand lane control.
				</p>
				<p>
					Also available in <a href="/es/">Español</a>, <a href="/pt-br/">Português (BR)</a>, and <a href="/zh-cn/">简体中文</a> (core pages).
				</p>
				<p>
					Play on Roblox: <a href={siteMeta.robloxExperienceUrl} rel="noopener noreferrer" target="_blank">{siteMeta.robloxExperienceLabel}</a>.
				</p>
			</section>
			<section>
				<h2>Official and source links</h2>
				<p>
					Use these when you want to verify the experience, join the community, or compare our notes against first-party channels.
				</p>
				<ul class="check-list">
					{officialLinks.map((link) => (
						<li>
							<a href={link[1]} rel="noopener noreferrer" target="_blank">{link[0]}</a>
						</li>
					))}
				</ul>
			</section>
			<section>
				<h2>FAQ</h2>
				<div class="faq-list">
					{faq.map((item) => (
						<details>
							<summary>{item.question}</summary>
							<p>{item.answer}</p>
						</details>
					))}
				</div>
			</section>
			<p class="notice" style="margin-top: 24px;">
				{siteMeta.lastPublicReviewNoteEn}
			</p>
			<p class="muted">
				<a href="/about/">About this site</a> · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/discord/">Official links</a>
			</p>
		</div>
	</section>
</BaseLayout>
