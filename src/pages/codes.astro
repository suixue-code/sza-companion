---
import BaseLayout from '@layouts/BaseLayout.astro';
import CodesActiveTable from '@components/codes/CodesActiveTable.astro';
import CodesHonestyNotice from '@components/codes/CodesHonestyNotice.astro';
import CodeAlertSubscribe from '@components/codes/CodeAlertSubscribe.astro';
import CodesOtherTable from '@components/codes/CodesOtherTable.astro';
import ToolsGuidesStrip from '@components/ToolsGuidesStrip.astro';
import codes from '../data/codes.json';
import siteMeta from '../data/site-meta.json';
import { articleSchema, breadcrumbSchema, faqSchema, itemListSchema } from '@lib/seo';

const codesPageUrl = new URL('/codes/', Astro.site).toString();

const faq = [
	{
		question: 'Is the Zombies code still working in Survive Zombie Arena?',
		answer:
			'Zombies (2,500 Credits) is high-confidence active per official Discord #codes and nine tracked guides as of May 2026. Re-confirm in-game before each session — codes can expire without notice.',
	},
	{
		question: 'Are Survive Zombie Arena codes case-sensitive?',
		answer: 'Most Roblox titles treat codes as case-sensitive. Try exact casing first — Zombies, not zombies.',
	},
	{
		question: 'Why is there only one active code?',
		answer:
			'Official Discord #codes has only posted Zombies since February 2026. We list GALACTIC separately as disputed because media guides disagree with Discord and community trackers.',
	},
	{
		question: 'Do codes give weapons or classes?',
		answer: 'Known working code Zombies grants 2,500 Credits only. Credits spend on in-run weapons and permanent class unlocks in the lobby shop.',
	},
	{
		question: 'What should I do after redeeming codes?',
		answer: 'Use the Credit Planner to decide Medic vs Marksman, then follow the beginner guide weapon path (handgun → shotgun → rifle).',
	},
];

const activeCodes = codes.filter((code) => code.status === 'active');
const disputedCodes = codes.filter((code) => code.status === 'disputed');
const otherCodes = codes.filter((code) => code.status !== 'active' && code.status !== 'disputed');

const tableLabels = {
	code: 'Code',
	reward: 'Reward',
	status: 'Status',
	checked: 'Checked',
	action: 'Copy',
	copy: 'Copy code',
	confidencePrefix: 'Confidence: ',
	sourceLabels: {
		howWeKnow: 'How we know',
		statusBasis: 'Status basis',
		conflict: 'Conflict',
		legacySources: 'Other references',
		inGame: 'In-game test on this site',
		sourcesToggle: 'Source details',
	},
};

const schema = [
	articleSchema({
		title: 'Survive Zombie Arena Codes (May 2026)',
		description: 'Active and disputed Survive Zombie Arena codes with redeem steps and source confidence labels.',
		url: codesPageUrl,
		dateModified: siteMeta.lastPublicReview,
	}),
	itemListSchema(
		'Active Survive Zombie Arena codes',
		activeCodes.map((code) => ({
			name: code.code,
			url: `${codesPageUrl}#${code.code.toLowerCase()}`,
		})),
	),
	faqSchema(faq),
	breadcrumbSchema([
		{ name: 'Home', url: new URL('/', Astro.site).toString() },
		{ name: 'Codes', url: codesPageUrl },
	]),
];
---

<BaseLayout
	title="Survive Zombie Arena Codes (May 2026) — Active & Disputed"
	description="Survive Zombie Arena codes: Zombies (2,500 Credits) active; GALACTIC disputed. Redeem steps, source links, and FAQ for Roblox players."
	schema={schema}
>
	<section class="page-hero compact">
		<div class="shell two-col mobile-hero-stack">
			<div>
				<p class="eyebrow"><span class="pulse"></span>Updated {siteMeta.lastPublicReviewDisplay}</p>
				<h1>Survive Zombie Arena Codes</h1>
				<p class="geo-snap">
					<strong>Zombies</strong> gives 2,500 Credits and is our only high-confidence active code. <strong>GALACTIC</strong> is listed under disputed codes — some sites say it works, but official Discord has not posted it.
				</p>
				<p class="lead">Open Shop → Redeem Codes in the lobby. We split active and disputed codes so you do not waste time on bad lists.</p>
			</div>
			<aside class="quick-answer">
				<strong>Fast answer</strong>
				<p>
					Try <strong>Zombies</strong> for 2,500 Credits. Do not assume <strong>GALACTIC</strong> works until your in-game redeem succeeds. Codes can expire after {siteMeta.lastPublicReviewDisplay}.
				</p>
			</aside>
		</div>
	</section>

	<section class="content-section">
		<div class="shell">
			<CodesHonestyNotice locale="en" />
			<div class="section-title" style="margin-top: 24px;">
				<h2>Active codes</h2>
				<p>Multi-source agreement and official Discord #codes post (Feb 1, 2026).</p>
			</div>
			<CodesActiveTable codes={activeCodes} labels={tableLabels} />
			<p class="notice" style="margin-top: 1rem;">
				Click 👍 or 👎 to say if a code worked on your account. Votes stay on your device and help us know when to re-check Discord — they do not change labels automatically.
			</p>
		</div>
	</section>

	{
		disputedCodes.length > 0 && (
			<section class="content-section">
				<div class="shell">
					<div class="section-title">
						<h2>Disputed codes</h2>
						<p>Public sources conflict — we do not promote these as working until in-game redeem succeeds.</p>
					</div>
					<CodesOtherTable
						codes={disputedCodes}
						labels={{ ...tableLabels, source: 'Source' }}
						statusLabel={{ disputed: 'disputed' }}
					/>
				</div>
			</section>
		)
	}

	{
		otherCodes.length > 0 && (
			<section class="content-section">
				<div class="shell">
					<div class="section-title">
						<h2>Expired or unverified</h2>
						<p>Kept visible when tracker pages disagree after Roblox updates.</p>
					</div>
					<CodesOtherTable codes={otherCodes} labels={{ ...tableLabels, source: 'Source' }} />
				</div>
			</section>
		)
	}

	<section class="content-section">
		<div class="shell article-grid">
			<article class="article-flow">
				<section>
					<h2>How to redeem Survive Zombie Arena codes</h2>
					<ol class="check-list">
						<li>Launch Survive Zombie Arena on Roblox and enter the lobby.</li>
						<li>Open <strong>Shop</strong> (left side of the lobby UI).</li>
						<li>Scroll down to the <strong>Redeem Codes</strong> box.</li>
						<li>Paste the code exactly as shown (case-sensitive).</li>
						<li>Press <strong>Redeem</strong> and read the reward message before closing.</li>
					</ol>
				</section>
				<section>
					<h2>Where codes come from</h2>
					<ul class="check-list">
						<li>Official Discord #patch-notes and #giveaways</li>
						<li>
							<a href={siteMeta.robloxExperienceUrl} rel="noopener noreferrer" target="_blank">Roblox experience page</a> social links
						</li>
						<li>
							<a href={siteMeta.robloxGroupUrl} rel="noopener noreferrer" target="_blank">{siteMeta.robloxGroupLabel}</a> Roblox group
						</li>
					</ul>
				</section>
				<section>
					<h2>FAQ</h2>
					<div class="faq-list">
						{faq.map((item) => (
							<details>
								<summary>{item.question}</summary>
								<p>{item.answer}</p>
							</details>
						))}
					</div>
				</section>
			</article>
			<aside class="side-rail">
				<CodeAlertSubscribe />
				<div class="rail-panel accent-panel">
					<strong>After redeeming</strong>
					<p>Plan your first class unlock with the Credit Planner — Medic (10k) or Marksman (15k).</p>
					<a href="/tools/credit-planner/">Open Credit Planner</a>
					<a href="/beginner-guide/">Read beginner guide</a>
				</div>
				<div class="rail-panel">
					<strong>Related pages</strong>
					<a href="/classes/">All classes & costs</a>
					<a href="/events/galactic/">Galactic Event</a>
					<a href="/discord/">Official Discord</a>
				</div>
			</aside>
		</div>
	</section>

	<ToolsGuidesStrip />

	<script is:inline>
		async function copyText(value) {
			if (navigator.clipboard?.writeText) {
				try {
					await navigator.clipboard.writeText(value);
					return;
				} catch (_error) {}
			}
			const textarea = document.createElement('textarea');
			textarea.value = value;
			textarea.setAttribute('readonly', '');
			textarea.style.position = 'fixed';
			textarea.style.opacity = '0';
			document.body.appendChild(textarea);
			textarea.select();
			document.execCommand('copy');
			textarea.remove();
		}

		document.querySelectorAll('[data-copy]').forEach((button) => {
			button.addEventListener('click', async () => {
				const value = button.getAttribute('data-copy') || '';
				await copyText(value);
				button.textContent = 'Copied';
				button.classList.add('copied');
				window.setTimeout(() => {
					button.textContent = 'Copy';
					button.classList.remove('copied');
				}, 1400);
			});
		});
	</script>
</BaseLayout>
