---
import BaseLayout from '@layouts/BaseLayout.astro';
import CodesActiveTable from '@components/codes/CodesActiveTable.astro';
import CodesHonestyNotice from '@components/codes/CodesHonestyNotice.astro';
import CodeAlertSubscribe from '@components/codes/CodeAlertSubscribe.astro';
import CodesOtherTable from '@components/codes/CodesOtherTable.astro';
import ToolsGuidesStrip from '@components/ToolsGuidesStrip.astro';
import codes from '../data/codes.json';
import siteMeta from '../data/site-meta.json';
import { articleSchema, breadcrumbSchema, faqSchema, itemListSchema } from '@lib/seo';

const codesPageUrl = new URL('/codes/', Astro.site).toString();

const faq = [
	{
		question: 'Is the Zombies code still working in Survive Zombie Arena?',
		answer:
			'Zombies (2,500 Credits) is high-confidence active per official Discord #codes and nine tracked guides as of May 2026. Re-confirm in-game before each session — codes can expire without notice.',
	},
	{
		question: 'Are Survive Zombie Arena codes case-sensitive?',
		answer: 'Most Roblox titles treat codes as case-sensitive. Try exact casing first — Zombies, not zombies.',
	},
	{
		question: 'Why is there only one active code?',
		answer:
			'Official Discord #codes has only posted Zombies since February 2026. We list GALACTIC separately as disputed because media guides disagree with Discord and community trackers.',
	},
	{
		question: 'Do codes give weapons or classes?',
		answer: 'Known working code Zombies grants 2,500 Credits only. Credits spend on in-run weapons and permanent class unlocks in the lobby shop.',
	},
	{
		question: 'What should I do after redeeming codes?',
		answer: 'Use the Credit Planner to decide Medic vs Marksman, then follow the beginner guide weapon path (handgun → shotgun → rifle).',
	},
];

const activeCodes = codes.filter((code) => code.status === 'active');
const disputedCodes = codes.filter((code) => code.status === 'disputed');
const otherCodes = codes.filter((code) => code.status !== 'active' && code.status !== 'disputed');

const citeSentence = `As of ${siteMeta.lastPublicReviewDisplay}, Survive Zombie Arena code Zombies (2,500 Credits) is active per prior Discord and public source audit; GALACTIC remains disputed because public guides disagree on both status and reward. Unofficial tracker: ${codesPageUrl}`;

const codeUseRows = [
	['Brand-new player', 'Redeem Zombies, then save for shotgun before chasing classes.', '/beginner-guide/'],
	['Solo first unlock', 'Put the 2,500 Credits toward Marksman after the handgun → shotgun → rifle habit is stable.', '/tools/credit-planner/'],
	['Co-op support', 'Use the Credits as a head start toward Medic, then learn revive and heal timing.', '/classes/medic/'],
	['GALACTIC checker', 'Treat GALACTIC as a one-time test only; do not budget around it until redeem succeeds.', '/codes/galactic/'],
];

const relatedCodeRoutes = [
	['How to redeem codes', '/guides/how-to-redeem-codes/', 'Step-by-step lobby Shop path and common redeem errors.'],
	['GALACTIC status', '/codes/galactic/', 'Why public guides disagree and what to do if the code fails.'],
	['Credit Planner', '/tools/credit-planner/', 'Turn 2,500 Credits into a concrete class unlock plan.'],
	['Beginner guide', '/beginner-guide/', 'First runs, weapon path, and early Credit mistakes.'],
	['Galactic Event', '/events/galactic/', 'Void Shards, Galactic Crates, Atlantis notes, and GALACTIC context.'],
];

const tableLabels = {
	code: 'Code',
	reward: 'Reward',
	status: 'Status',
	checked: 'Checked',
	action: 'Copy',
	copy: 'Copy code',
	confidencePrefix: 'Confidence: ',
	sourceLabels: {
		howWeKnow: 'How we know',
		statusBasis: 'Status basis',
		conflict: 'Conflict',
		legacySources: 'Other references',
		inGame: 'In-game test on this site',
		sourcesToggle: 'Source details',
	},
};

const schema = [
	articleSchema({
		title: 'Survive Zombie Arena Codes 2026: Zombies + GALACTIC Status',
		description: 'June 2026 Survive Zombie Arena codes: copy Zombies for 2,500 Credits, check GALACTIC status, and redeem codes in the Roblox Shop.',
		url: codesPageUrl,
		dateModified: siteMeta.lastPublicReview,
	}),
	itemListSchema(
		'Active Survive Zombie Arena codes',
		activeCodes.map((code) => ({
			name: code.code,
			url: `${codesPageUrl}#${code.code.toLowerCase()}`,
		})),
	),
	faqSchema(faq),
	breadcrumbSchema([
		{ name: 'Home', url: new URL('/', Astro.site).toString() },
		{ name: 'Codes', url: codesPageUrl },
	]),
];
---

<BaseLayout
	title="Survive Zombie Arena Codes 2026: Zombies + GALACTIC Status"
	description="June 2026 Survive Zombie Arena codes: copy Zombies for 2,500 Credits, check GALACTIC status, and redeem codes in the Roblox Shop."
	schema={schema}
>
	<section class="page-hero compact">
		<div class="shell two-col mobile-hero-stack">
			<div>
				<p class="eyebrow"><span class="pulse"></span>Updated {siteMeta.lastPublicReviewDisplay}</p>
				<h1>Survive Zombie Arena Codes 2026</h1>
				<p class="geo-snap">
					Copy <strong>Zombies</strong> for 2,500 Credits first. <strong>GALACTIC</strong> has conflicting reward reports, so we keep it separate with source notes instead of pretending every list agrees.
				</p>
				<p class="lead">Open Shop → Redeem Codes in the Roblox lobby. The working-code table comes first, followed by a short GALACTIC check, June 2026 source notes, and next-spend planner.</p>
			</div>
			<aside class="quick-answer">
				<strong>Working code now</strong>
				<p>
					<strong>Zombies</strong> gives 2,500 Credits. Check <strong>GALACTIC</strong> below before you count on it in June 2026.
				</p>
			</aside>
		</div>
	</section>

	<section class="content-section">
		<div class="shell">
			<nav class="rail-panel" aria-label="Codes page sections">
				<strong>On this page</strong>
				<p style="margin: 8px 0 0;">
					<a href="#active-codes">Active codes</a> · <a href="/codes/galactic/">GALACTIC status</a> · <a href="#redeem">How to redeem</a> · <a href="#spend">Spend Credits</a> · <a href="#code-vs-codes">Code vs codes</a> · <a href="#faq">FAQ</a>
				</p>
			</nav>
			<CodesHonestyNotice locale="en" />
			<div class="rail-panel accent-panel" style="margin-top: 20px;">
				<strong>Code status receipt</strong>
				<div class="table-wrap" style="margin-top: 10px;">
					<table class="data-table">
						<thead>
							<tr>
								<th>Code</th>
								<th>Reward</th>
								<th>Status</th>
								<th>Checked</th>
							</tr>
						</thead>
						<tbody>
							{codes.map((code) => (
								<tr>
									<td>{code.code}</td>
									<td>{code.rewardAmount ? `${code.rewardAmount.toLocaleString()} Credits` : code.reward}</td>
									<td>{code.status}</td>
									<td>{code.lastCheckedAt?.slice(0, 10) ?? code.lastVerified}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p style="margin: 12px 0;">{citeSentence}</p>
				<button type="button" class="btn secondary" data-copy={citeSentence}>Copy citation</button>
				<p class="muted" style="margin-top: 10px;">
					<a href="/sources/">Full source ledger & how to cite</a>
				</p>
			</div>
			<div class="section-title" id="active-codes" style="margin-top: 24px;">
				<h2>Active codes</h2>
				<p>Multi-source agreement and official Discord #codes post (Feb 1, 2026).</p>
			</div>
			<CodesActiveTable codes={activeCodes} labels={tableLabels} />
			<p class="notice" style="margin-top: 1rem;">
				Click 👍 or 👎 to say if a code worked on your account. Votes stay on your device and help us know when to re-check Discord — they do not change labels automatically.
			</p>
		</div>
	</section>

	{
		disputedCodes.length > 0 && (
			<section class="content-section">
				<div class="shell">
					<div class="section-title">
						<h2 id="galactic">Disputed codes</h2>
						<p>Public sources conflict — we do not promote these as working until in-game redeem succeeds.</p>
					</div>
					<CodesOtherTable
						codes={disputedCodes}
						labels={{ ...tableLabels, source: 'Source' }}
						statusLabel={{ disputed: 'disputed' }}
					/>
				</div>
			</section>
		)
	}

	{
		otherCodes.length > 0 && (
			<section class="content-section">
				<div class="shell">
					<div class="section-title">
						<h2>Expired or unverified</h2>
						<p>Kept visible when tracker pages disagree after Roblox updates.</p>
					</div>
					<CodesOtherTable codes={otherCodes} labels={{ ...tableLabels, source: 'Source' }} />
				</div>
			</section>
		)
	}

	<section class="content-section">
		<div class="shell article-grid">
			<article class="article-flow">
				<section id="redeem">
					<h2>How to redeem Survive Zombie Arena codes</h2>
					<ol class="check-list">
						<li>Launch Survive Zombie Arena on Roblox and enter the lobby.</li>
						<li>Open <strong>Shop</strong> (left side of the lobby UI).</li>
						<li>Scroll down to the <strong>Redeem Codes</strong> box.</li>
						<li>Paste the code exactly as shown (case-sensitive).</li>
						<li>Press <strong>Redeem</strong> and read the reward message before closing.</li>
					</ol>
				</section>
				<section id="spend">
					<h2>What to do with 2,500 Credits</h2>
					<p>
						Zombies gives a useful head start, but it is not enough for a class by itself. Use it to smooth your first weapon buys, then plan the permanent class unlock.
					</p>
					<div class="table-wrap">
						<table class="data-table">
							<thead>
								<tr>
									<th>Player goal</th>
									<th>Best next move</th>
									<th>Open</th>
								</tr>
							</thead>
							<tbody>
								{codeUseRows.map((row) => (
									<tr>
										<td><strong>{row[0]}</strong></td>
										<td>{row[1]}</td>
										<td><a href={row[2]}>Guide</a></td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</section>
				<section>
					<h2>Where codes come from</h2>
					<ul class="check-list">
						<li>Official Discord #patch-notes and #giveaways</li>
						<li>
							<a href={siteMeta.robloxExperienceUrl} rel="noopener noreferrer" target="_blank">Roblox experience page</a> social links
						</li>
						<li>
							<a href={siteMeta.robloxGroupUrl} rel="noopener noreferrer" target="_blank">{siteMeta.robloxGroupLabel}</a> Roblox group
						</li>
					</ul>
				</section>
				<section id="code-vs-codes">
					<h2>Code, codes, and 2026 searches</h2>
					<p>
						If you searched for <strong>Survive Zombie Arena code</strong>, <strong>Survive Zombie Arena codes 2026</strong>, or <strong>Roblox Survive Zombie Arena codes</strong>, use the same table above. We keep one canonical list so Zombies, GALACTIC, expired codes, and source conflicts do not split across thin pages.
					</p>
					<p>
						For event tasks that are not text codes, use the <a href="/events/medal-quest/">Survive Zombie Arena x Medal guide</a>. For first-party game links, use the <a href="/roblox/">Roblox page</a>.
					</p>
				</section>
				<section>
					<h2>Related code guides</h2>
					<div class="shortcut-grid">
						{relatedCodeRoutes.map((route) => (
							<a class="shortcut" href={route[1]}>
								<strong>{route[0]}</strong>
								<p>{route[2]}</p>
							</a>
						))}
					</div>
				</section>
				<section id="faq">
					<h2>FAQ</h2>
					<div class="faq-list">
						{faq.map((item) => (
							<details>
								<summary>{item.question}</summary>
								<p>{item.answer}</p>
							</details>
						))}
					</div>
				</section>
			</article>
			<aside class="side-rail">
				<CodeAlertSubscribe />
				<div class="rail-panel accent-panel">
					<strong>After redeeming</strong>
					<p>Plan your first class unlock with the Credit Planner — Medic (10k) or Marksman (15k).</p>
					<a href="/tools/credit-planner/">Open Credit Planner</a>
					<a href="/beginner-guide/">Read beginner guide</a>
				</div>
				<div class="rail-panel">
					<strong>Related pages</strong>
					<a href="/classes/">All classes & costs</a>
					<a href="/events/galactic/">Galactic Event</a>
					<a href="/discord/">Official Discord</a>
				</div>
			</aside>
		</div>
	</section>

	<ToolsGuidesStrip />

	<script is:inline>
		async function copyText(value) {
			if (navigator.clipboard?.writeText) {
				try {
					await navigator.clipboard.writeText(value);
					return;
				} catch (_error) {}
			}
			const textarea = document.createElement('textarea');
			textarea.value = value;
			textarea.setAttribute('readonly', '');
			textarea.style.position = 'fixed';
			textarea.style.opacity = '0';
			document.body.appendChild(textarea);
			textarea.select();
			document.execCommand('copy');
			textarea.remove();
		}

		document.querySelectorAll('[data-copy]').forEach((button) => {
			button.addEventListener('click', async () => {
				const value = button.getAttribute('data-copy') || '';
				await copyText(value);
				button.textContent = 'Copied';
				button.classList.add('copied');
				window.setTimeout(() => {
					button.textContent = 'Copy';
					button.classList.remove('copied');
				}, 1400);
			});
		});
	</script>
</BaseLayout>
