---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Implementation Status" description="SZA Companion PRD implementation checklist." noindex>
	<section class="page-hero compact">
		<div class="shell">
			<p class="eyebrow"><span class="pulse"></span>Noindex · PRD tracker</p>
			<h1>Implementation Status</h1>
			<p class="lead">74 pages · 4 locales · deploy deferred.</p>
		</div>
	</section>
	<section class="content-section">
		<div class="shell article-flow">
			<section>
				<h2>Languages (P3-001 / P3-002)</h2>
				<ul class="check-list">
					<li>✅ English — full site</li>
					<li>✅ Español — 7 core pages at <code>/es/</code></li>
					<li>✅ Português (BR) — 7 core pages at <code>/pt-br/</code></li>
					<li>✅ 简体中文 — 7 core pages at <code>/zh-cn/</code></li>
					<li>✅ hreflang + Header language switcher</li>
					<li>✅ Copy in <code>src/i18n/localized/*.ts</code></li>
					<li>⬜ Full guide translation (20 guides × 3 langs) — backlog</li>
				</ul>
			</section>
			<section>
				<h2>Core product</h2>
				<ul class="check-list">
					<li>✅ 53 English pages + 21 localized routes</li>
					<li>✅ Codes feedback · 3 tools · 20 EN guides</li>
					<li>⬜ Deploy · AdSense · in-game code verify</li>
				</ul>
			</section>
		</div>
	</section>
</BaseLayout>
