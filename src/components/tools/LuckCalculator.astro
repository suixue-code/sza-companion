---
import ToolsGuidesStrip from '@components/ToolsGuidesStrip.astro';
import targets from '../../data/calculator-targets.json';
import presetMeta from '../../data/calculator-presets-meta.json';
import type { LocaleCode } from '@i18n/config';
import { getLuckCalculatorCopy } from '@i18n/luck-calculator';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const c = getLuckCalculatorCopy(locale);
const presetNotice =
	locale === 'zh-cn'
		? `预设批次 **${presetMeta.presetBatchId}** · 最近核对 ${presetMeta.lastCheckedAt}。${presetMeta.sourceNote}`
		: `Preset batch <strong>${presetMeta.presetBatchId}</strong> · last reviewed ${presetMeta.lastCheckedAt}. ${presetMeta.sourceNote}`;
---

<section class="page-hero compact">
	<div class="shell two-col mobile-hero-stack">
		<div>
			<p class="eyebrow"><span class="pulse"></span>{c.eyebrow}</p>
			<h1>{c.h1}</h1>
			<p class="geo-snap">{c.snap}</p>
			<p class="lead">{c.lead}</p>
			<p class="notice" style="margin-top: 12px;" set:html={presetNotice} />
		</div>
		<aside class="quick-answer">
			<strong>{c.useForTitle}</strong>
			<p>{c.useForBody}</p>
		</aside>
	</div>
</section>

<section class="content-section">
	<div class="shell tool-grid">
		<form class="tool-panel" id="luck-form">
			<h2>{c.inputs}</h2>
			<div class="form-grid">
				<label class="field"
					>{c.targetPreset}
					<select class="select" id="target">
						{targets.map((target) => (
							<option value={target.baseOdds}>
								{target.targetName} · 1/{target.baseOdds.toLocaleString()}
							</option>
						))}
					</select>
				</label>
				<label class="field"
					>{c.baseOdds}
					<input class="input" id="baseOdds" type="number" min="1" step="1" value={targets[0].baseOdds} />
				</label>
				<label class="field"
					>{c.luckMult}
					<input class="input" id="luck" type="number" min="1" step="0.1" value="1" />
				</label>
				<label class="field"
					>{c.rebirthMult}
					<input class="input" id="rebirth" type="number" min="1" step="0.1" value="1" />
				</label>
				<label class="field"
					>{c.luckBoost}
					<input class="input" id="boost" type="number" min="1" step="0.1" value="1" />
				</label>
				<label class="field"
					>{c.ultraBoost}
					<input class="input" id="ultra" type="number" min="1" step="0.1" value="1" />
				</label>
				<label class="field"
					>{c.rollInterval}
					<input class="input" id="interval" type="number" min="0.05" step="0.05" value="1.5" />
				</label>
				<label class="field"
					>{c.sessionHours}
					<input class="input" id="hours" type="number" min="0.1" step="0.1" value="6" />
				</label>
			</div>
		</form>

		<section class="tool-panel">
			<h2>{c.results}</h2>
			<div class="result-grid">
				<div class="metric"><span>{c.metrics.effectiveOdds}</span><strong id="effectiveOdds">-</strong></div>
				<div class="metric"><span>{c.metrics.rollsPerHour}</span><strong id="rollsPerHour">-</strong></div>
				<div class="metric"><span>{c.metrics.expectedTime}</span><strong id="expectedTime">-</strong></div>
				<div class="metric"><span>{c.metrics.sessionChance}</span><strong id="sessionChance">-</strong></div>
				<div class="metric"><span>{c.metrics.chance1h}</span><strong id="chance1">-</strong></div>
				<div class="metric"><span>{c.metrics.chance24h}</span><strong id="chance24">-</strong></div>
			</div>
			<p class="notice" id="recommendation">{c.estimateOnly}</p>
			<p id="calc-share-status" class="calc-sr-announce" aria-live="polite"></p>
			<div class="actions">
				<button class="btn primary" id="shareResult" type="button">{c.shareLink}</button>
				<button class="btn secondary" id="copyResult" type="button">{c.copySummary}</button>
			</div>
		</section>
	</div>
</section>

<section class="content-section">
	<div class="shell article-flow">
		<section>
			<h2>{c.formulaTitle}</h2>
			<p><code>{c.formulaCode}</code>{c.formulaRest}</p>
		</section>
		<section>
			<h2>{c.faqHeading}</h2>
			<div class="faq-list">
				{c.faq.map((item) => (
					<details>
						<summary>{item.question}</summary>
						<p>{item.answer}</p>
					</details>
				))}
			</div>
		</section>
	</div>
</section>

<ToolsGuidesStrip locale={locale} />

<script is:inline define:vars={{ scriptBundle: c.script, localeTag: locale }}>
	const S = scriptBundle;
	const fields = ['baseOdds', 'luck', 'rebirth', 'boost', 'ultra', 'interval', 'hours'];
	const get = (id) => document.getElementById(id);
	const fmt = new Intl.NumberFormat(S.numberLocale, { maximumFractionDigits: 2 });
	const pct = (value) => `${(value * 100).toFixed(value < 0.01 ? 3 : 2)}%`;

	async function copyText(value) {
		if (navigator.clipboard?.writeText) {
			try {
				await navigator.clipboard.writeText(value);
				return;
			} catch (_error) {}
		}
		const textarea = document.createElement('textarea');
		textarea.value = value;
		textarea.setAttribute('readonly', '');
		textarea.style.position = 'fixed';
		textarea.style.opacity = '0';
		document.body.appendChild(textarea);
		textarea.select();
		document.execCommand('copy');
		textarea.remove();
	}

	function announce(msg) {
		const el = get('calc-share-status');
		if (el) {
			el.textContent = '';
			el.textContent = msg;
		}
	}

	function flashButton(btn, tempLabel, revertLabel, ms = 1400) {
		btn.textContent = tempLabel;
		setTimeout(() => {
			btn.textContent = revertLabel;
		}, ms);
	}

	function removeCustomPresetOption() {
		const sel = get('target');
		sel.querySelectorAll('option[data-calc-custom]').forEach((n) => n.remove());
	}

	function syncTargetSelectFromBaseOdds() {
		const sel = get('target');
		const raw = Number(get('baseOdds').value);
		if (!Number.isFinite(raw) || raw < 1) return;
		removeCustomPresetOption();
		const bo = raw;
		for (let i = 0; i < sel.options.length; i++) {
			const opt = sel.options[i];
			if (opt.hasAttribute('data-calc-custom')) continue;
			if (Number(opt.value) === bo) {
				sel.selectedIndex = i;
				return;
			}
		}
		const custom = document.createElement('option');
		custom.value = String(bo);
		custom.textContent = `${S.customPreset} · 1/${bo.toLocaleString(S.numberLocale)}`;
		custom.setAttribute('data-calc-custom', '');
		sel.appendChild(custom);
		sel.value = String(bo);
	}

	function safeNumber(id, fallback) {
		const value = Number(get(id)?.value);
		return Number.isFinite(value) && value > 0 ? value : fallback;
	}

	function chanceFor(hours) {
		const baseOdds = safeNumber('baseOdds', 1000);
		const totalLuck = safeNumber('luck', 1) * safeNumber('rebirth', 1) * safeNumber('boost', 1) * safeNumber('ultra', 1);
		const probability = Math.min((1 / baseOdds) * totalLuck, 1);
		const rolls = (hours * 3600) / safeNumber('interval', 1.5);
		return { probability, rolls, chance: 1 - Math.pow(1 - probability, rolls), baseOdds, totalLuck };
	}

	function computeMetrics() {
		const sessionHours = safeNumber('hours', 6);
		const current = chanceFor(sessionHours);
		const one = chanceFor(1);
		const six = chanceFor(6);
		const day = chanceFor(24);
		const interval = safeNumber('interval', 1.5);
		const effectiveOdds = current.probability > 0 ? 1 / current.probability : Infinity;
		const expectedSeconds = interval / current.probability;
		const expectedHours = expectedSeconds / 3600;
		return {
			sessionHours,
			current,
			one,
			six,
			day,
			interval,
			effectiveOdds,
			expectedHours,
		};
	}

	function getSelectedTargetLabel() {
		const sel = get('target');
		const opt = sel.options[sel.selectedIndex];
		return opt ? opt.textContent.trim() : S.customPreset;
	}

	function buildShareSummary(m) {
		const baseOdds = m.current.baseOdds;
		const targetLine = getSelectedTargetLabel();
		const tl = m.current.probability > 0 ? 1 / m.current.probability : Infinity;
		const effectiveStr = `1 / ${fmt.format(tl)}`;
		const expectedStr =
			m.expectedHours > 48
				? `${fmt.format(m.expectedHours / 24)} ${S.days}`
				: `${fmt.format(m.expectedHours)} ${S.hours}`;
		const sep = localeTag === 'zh-cn' ? '；' : '; ';
		const inputDesc =
			localeTag === 'zh-cn'
				? `输入 — 综合幸运 ×${fmt.format(m.current.totalLuck)}（luck×rebirth×boost×ultra）${sep}抽奖间隔 ${fmt.format(m.interval)} 秒${sep}单次游玩 ${fmt.format(m.sessionHours)} 小时`
				: localeTag === 'es'
					? `Entradas — suerte combinada ×${fmt.format(m.current.totalLuck)} (luck×rebirth×boost×ultra)${sep}intervalo ${fmt.format(m.interval)} s${sep}sesión ${fmt.format(m.sessionHours)} h`
					: `${S.summaryInputsPrefix} — combined luck ×${fmt.format(m.current.totalLuck)} (luck×rebirth×boost×ultra)${sep}roll interval ${fmt.format(m.interval)}s${sep}session ${fmt.format(m.sessionHours)} h`;
		const sessionLine =
			localeTag === 'zh-cn'
				? `- 单次 ${fmt.format(m.sessionHours)} 小时内至少命中一次：${pct(m.current.chance)}`
				: localeTag === 'es'
					? `- Sesión (${fmt.format(m.sessionHours)} h): ≥1 acierto ${pct(m.current.chance)}`
					: `- ${fmt.format(m.sessionHours)}h ${S.summarySession} ${pct(m.current.chance)}`;
		const lines = [
			S.summaryTitle,
			'',
			`${S.summaryTarget} ${targetLine}`,
			`${S.summaryBaseOdds} 1 / ${fmt.format(baseOdds)}`,
			'',
			inputDesc,
			'',
			S.summaryResults,
			`- ${S.summaryEffective} ${effectiveStr}`,
			`- ${S.summaryRollsPerH} ${fmt.format(m.one.rolls)}`,
			`- ${S.summaryExpected} ${expectedStr}`,
			`- ${S.summary1h} ${pct(m.one.chance)}`,
			sessionLine,
			`- ${S.summary24h} ${pct(m.day.chance)}`,
			'',
			S.summaryDisclaimer,
			'',
			`${S.summaryLinkLine} ${location.href}`,
		];
		return lines.join('\n');
	}

	function render() {
		syncTargetSelectFromBaseOdds();
		const sessionHours = safeNumber('hours', 6);
		const current = chanceFor(sessionHours);
		const one = chanceFor(1);
		const six = chanceFor(6);
		const day = chanceFor(24);
		const effectiveOdds = current.probability > 0 ? 1 / current.probability : Infinity;
		const interval = safeNumber('interval', 1.5);
		const expectedSeconds = interval / current.probability;
		const expectedHours = expectedSeconds / 3600;
		get('effectiveOdds').textContent = `1 / ${fmt.format(effectiveOdds)}`;
		get('rollsPerHour').textContent = fmt.format(one.rolls);
		get('expectedTime').textContent =
			expectedHours > 48 ? `${fmt.format(expectedHours / 24)} ${S.days}` : `${fmt.format(expectedHours)} ${S.hours}`;
		get('sessionChance').textContent = pct(current.chance);
		get('chance1').textContent = pct(one.chance);
		get('chance24').textContent = pct(day.chance);
		get('recommendation').textContent = six.chance < 0.05 ? S.recommendationLow : S.recommendationOk;
		const params = new URLSearchParams();
		fields.forEach((id) => params.set(id, get(id).value));
		history.replaceState(null, '', `${location.pathname}?${params.toString()}`);
	}

	function restore() {
		const params = new URLSearchParams(location.search);
		fields.forEach((id) => {
			if (params.has(id)) get(id).value = params.get(id);
		});
	}

	get('target').addEventListener('change', (event) => {
		const sel = event.target;
		removeCustomPresetOption();
		get('baseOdds').value = sel.value;
		render();
	});
	fields.forEach((id) => get(id).addEventListener('input', render));

	async function shareOrCopyLink() {
		const url = location.href;
		const shareData = {
			title: S.shareTitle,
			text: S.shareText,
			url,
		};
		try {
			if (typeof navigator.share === 'function' && (!navigator.canShare || navigator.canShare(shareData))) {
				await navigator.share(shareData);
				flashButton(get('shareResult'), S.shared, S.shareBtnDefault);
				announce(S.linkShared);
				return;
			}
		} catch (err) {
			if (err && err.name === 'AbortError') return;
		}
		await copyText(url);
		flashButton(get('shareResult'), S.copiedLink, S.shareBtnDefault);
		announce(S.linkCopied);
	}

	get('shareResult').addEventListener('click', shareOrCopyLink);
	get('copyResult').addEventListener('click', async () => {
		const text = buildShareSummary(computeMetrics());
		await copyText(text);
		flashButton(get('copyResult'), S.copied, S.copyBtnDefault);
		announce(S.summaryCopied);
	});

	restore();
	render();
</script>
