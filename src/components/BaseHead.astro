---
import '@styles/global.css';
import type { LocaleCode } from '@i18n/config';
import { defaultLocale, localeConfig } from '@i18n/config';
import { ogStrings } from '@i18n/ui';
import { getAlternateHrefMap } from '@i18n/utils';
import { SITE_NAME } from '@lib/seo';

interface Props {
	title: string;
	description: string;
	locale?: LocaleCode;
	image?: string;
	schema?: unknown[];
	noindex?: boolean;
}

const {
	title,
	description,
	locale = 'en',
	image = '/images/sza-og-default.svg',
	schema = [],
	noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const fullTitle = title.includes('Slime RNG') ? title : `${title} | ${SITE_NAME}`;
const alternateHrefs = getAlternateHrefMap(Astro.url.pathname);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />
<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" hreflang="x-default" href={new URL(alternateHrefs[defaultLocale], Astro.site)} />
{localeConfig.map((loc) => (
	<link rel="alternate" hreflang={loc.hreflang} href={new URL(alternateHrefs[loc.code], Astro.site)} />
))}
{noindex && <meta name="robots" content="noindex,nofollow" />}

<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={ogStrings[locale]} />
<meta property="og:image" content={imageURL} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

{
	schema.map((item) => (
		<script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
	))
}
