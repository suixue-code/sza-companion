---
import GuideSection from '@components/content/GuideSection.astro';
import ToolsGuidesStrip from '@components/ToolsGuidesStrip.astro';
import { linkifyGuidePaths, splitGuideParagraphs } from '@lib/readability';
import type { GuidePage } from '../../types/guides';

interface Props {
	guide: GuidePage;
	lastReviewed: string;
}

const { guide, lastReviewed } = Astro.props;
---

<article class="shell article-flow">
	<p class="eyebrow"><span class="pulse"></span>{guide.eyebrow ?? 'Guide'}</p>
	<h1>{guide.title}</h1>
	<p class="meta-line">Last reviewed {lastReviewed}</p>
	<p class="lede">{guide.description}</p>

	{
		guide.toolLinks && guide.toolLinks.length > 0 && (
			<div class="shortcut-grid" style="margin-bottom: 1.5rem;">
				{guide.toolLinks.map((link) => (
					<a class="shortcut" href={link.href}>
						<strong>{link.label}</strong>
					</a>
				))}
			</div>
		)
	}

	{
		guide.sections.map((section) => (
			<section class="guide-section">
				{section.level === 3 ? <h3>{section.heading}</h3> : <h2>{section.heading}</h2>}
				{
					section.body &&
						splitGuideParagraphs(section.body).map((paragraph) => (
							<p set:html={linkifyGuidePaths(paragraph)} />
						))
				}
				{
					section.items && section.items.length > 0 && (
						<ul class="check-list">
							{section.items.map((item) => (
								<li set:html={linkifyGuidePaths(item)} />
							))}
						</ul>
					)
				}
			</section>
		))
	}

	<section class="guide-section">
		<h2>FAQ</h2>
		<div class="faq-list">
			{guide.faq.map((item) => (
				<details class="faq-item">
					<summary>{item.question}</summary>
					<p>{item.answer}</p>
				</details>
			))}
		</div>
	</section>
</article>

<ToolsGuidesStrip />
